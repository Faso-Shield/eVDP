# =============================================================================
# eVDP - modele de configuration
#
#   cp .env.example .env
#   puis renseignez les valeurs marquees CHANGEZ-MOI.
#
# NE COMMITEZ JAMAIS le fichier .env : il est exclu par .gitignore.
# Generez une cle secrete avec :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# =============================================================================

# --- Django ------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=CHANGEZ-MOI-cle-secrete-de-64-caracteres-minimum
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,evdp-web,evdp-nginx
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
TIME_ZONE=Africa/Ouagadougou

# TLS : passez a True une fois le certificat installe sur Nginx.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=evdp
POSTGRES_USER=evdp
POSTGRES_PASSWORD=CHANGEZ-MOI-mot-de-passe-postgres
POSTGRES_HOST=evdp-db
POSTGRES_PORT=5432

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://evdp-redis:6379/0
CELERY_BROKER_URL=redis://evdp-redis:6379/0
CELERY_RESULT_BACKEND=redis://evdp-redis:6379/0
CELERY_CONCURRENCY=2

# --- MinIO (stockage prive des pieces jointes) -------------------------------
USE_S3=True
MINIO_ENDPOINT=http://evdp-minio:9000
MINIO_ROOT_USER=evdp-minio
MINIO_ROOT_PASSWORD=CHANGEZ-MOI-mot-de-passe-minio
MINIO_ACCESS_KEY=evdp-minio
MINIO_SECRET_KEY=CHANGEZ-MOI-mot-de-passe-minio
MINIO_BUCKET=evdp-attachments
MINIO_REGION=us-east-1

# --- Messagerie --------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=evdp-mailpit
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=eVDP <no-reply@evdp.bf>
# URL publique complete de l'instance : elle construit les liens des emails.
SITE_BASE_URL=CHANGEZ-MOI-http-ou-https://adresse-reelle-de-cette-instance

# --- Identite de la plateforme -----------------------------------------------
EVDP_NATIONAL_TEAM=ANSSI-BF / CSIRT National
EVDP_CONTACT_EMAIL=vdp@anssi.bf
EVDP_DEFAULT_CURRENCY=XOF
EVDP_DISCLOSURE_DELAY_DAYS=90
# Exigence d'adresse email verifiee pour participer aux Bug Bounty.
# EVDP_VERIFICATION_ENFORCED_FROM est la date de bascule (AAAA-MM-JJ) : les
# comptes crees AVANT conservent l'acces pendant EVDP_VERIFICATION_GRACE_DAYS
# jours et sont relances a EVDP_VERIFICATION_REMINDER_DAYS jours de l'echeance.
# Les comptes crees apres n'ont aucun sursis. Vide = application immediate,
# sans sursis pour personne.
EVDP_VERIFICATION_ENFORCED_FROM=
EVDP_VERIFICATION_GRACE_DAYS=30
EVDP_VERIFICATION_REMINDER_DAYS=14,7,1


# --- PGP ---------------------------------------------------------------------
# Cle PUBLIQUE nationale uniquement. eVDP ne stocke aucune cle privee.
# Sur une seule ligne, sauts de ligne echappes en \n.
PGP_PUBLIC_KEY=
PGP_FINGERPRINT=

# --- Pieces jointes ----------------------------------------------------------
EVDP_MAX_ATTACHMENT_SIZE=26214400
EVDP_MAX_ATTACHMENTS_PER_CASE=20
# Service ClamAV optionnel (laisser vide pour desactiver l'analyse antivirus).
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Anti-abus ---------------------------------------------------------------
EVDP_CAPTCHA_ENABLED=False
EVDP_RL_LOGIN=10/5m
EVDP_RL_REGISTER=5/1h
EVDP_RL_REPORT=10/1h
EVDP_RL_PASSWORD_RESET=5/1h
THROTTLE_REPORT_SUBMISSION=10/hour
THROTTLE_ANON_READ=60/hour
THROTTLE_AUTHENTICATED=1000/day

# --- Reputation (bareme configurable) ----------------------------------------
EVDP_REP_VALIDATED=10
EVDP_REP_HIGH=25
EVDP_REP_CRITICAL=50
EVDP_REP_DUPLICATE=0
EVDP_REP_ABUSIVE=-20

# --- Observabilite -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Infrastructure ----------------------------------------------------------
HTTP_PORT=80
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
