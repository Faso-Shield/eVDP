# =============================================================================
# eVDP - modele de configuration
#
#   cp .env.example .env
#   puis renseignez les valeurs marquees CHANGEZ-MOI.
#
# NE COMMITEZ JAMAIS le fichier .env : il est exclu par .gitignore.
# Generez une cle secrete avec :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# =============================================================================

# --- Django ------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=CHANGEZ-MOI-cle-secrete-de-64-caracteres-minimum
# Cle Fernet des donnees de versement chiffrees au repos (identite, IBAN,
# mobile money...). Generez-la avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sauvegardez-la HORS de la base : sans elle, ces donnees sont irrecuperables.
# Rotation : "nouvelle,ancienne", puis `manage.py rechiffrer_champs`.
FIELD_ENCRYPTION_KEY=CHANGEZ-MOI-cle-fernet
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,evdp-web,evdp-nginx
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
TIME_ZONE=Africa/Ouagadougou

# TLS : passez a True une fois le certificat installe sur Nginx (voir §4 de
# docs/deployment.md). Commande aussi les cookies Secure (SESSION_COOKIE_SECURE,
# CSRF_COOKIE_SECURE) et upgrade-insecure-requests, inutilisables en HTTP.
# En production HTTPS, utilisez :
#   SECURE_SSL_REDIRECT=True
#   SECURE_HSTS_SECONDS=31536000
#   CSRF_TRUSTED_ORIGINS=https://votre-domaine.bf
#   SITE_BASE_URL=https://votre-domaine.bf
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=evdp
POSTGRES_USER=evdp
POSTGRES_PASSWORD=CHANGEZ-MOI-mot-de-passe-postgres
POSTGRES_HOST=evdp-db
POSTGRES_PORT=5432

# --- Redis / Celery ----------------------------------------------------------
REDIS_PASSWORD=CHANGEZ-MOI-mot-de-passe-redis
REDIS_URL=redis://:CHANGEZ-MOI-mot-de-passe-redis@evdp-redis:6379/0
CELERY_BROKER_URL=redis://:CHANGEZ-MOI-mot-de-passe-redis@evdp-redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGEZ-MOI-mot-de-passe-redis@evdp-redis:6379/0
CELERY_CONCURRENCY=2

# --- Stockage des pieces jointes ---------------------------------------------
# Sur disque, dans le volume Docker evdp-media (jamais servi par Nginx : chaque
# telechargement passe par l'application). USE_S3=True renvoie vers un
# stockage S3 externe, decrit par les variables MINIO_* ci-dessous.
USE_S3=False
# MINIO_ENDPOINT=https://s3.exemple.bf
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=evdp-attachments
# MINIO_REGION=us-east-1

# --- Messagerie --------------------------------------------------------------
# Valeurs ci-dessous : Mailpit, faux serveur de developpement qui garde les
# emails sans les envoyer. En production, remplacez-les par le serveur SMTP
# de la structure (demande a son service informatique : hote, port, mode de
# chiffrement, compte et mot de passe). Procedure et test d'envoi :
# docs/messagerie.md (guide pas a pas).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Hote du serveur SMTP, par exemple smtp.ministere.gov.bf
EMAIL_HOST=evdp-mailpit
# 587 avec EMAIL_USE_TLS=True (STARTTLS, le plus courant)
# 465 avec EMAIL_USE_SSL=True (TLS des la connexion)
# 25 sans chiffrement ni compte (relais interne qui autorise l'IP du serveur)
# Jamais les deux a True : la plateforme refuse de demarrer.
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
# Compte d'envoi ; vides si le serveur accepte la plateforme sans authentification.
EMAIL_USER=
EMAIL_PASSWORD=
# Delai maximal d'une connexion SMTP, en secondes.
EMAIL_TIMEOUT=30
# Expediteur affiche. Son domaine doit etre celui du serveur SMTP, avec
# SPF, DKIM et DMARC configures, sinon les emails arrivent en spam.
DEFAULT_FROM_EMAIL=eVDP <no-reply@evdp.bf>
# URL publique complete de l'instance : elle construit les liens des emails.
SITE_BASE_URL=CHANGEZ-MOI-http-ou-https://adresse-reelle-de-cette-instance

# --- Identite de la plateforme -----------------------------------------------
EVDP_NATIONAL_TEAM=ANSSI-BF / CSIRT National
EVDP_CONTACT_EMAIL=vdp@anssi.bf
EVDP_DEFAULT_CURRENCY=XOF
EVDP_DISCLOSURE_DELAY_DAYS=90
# Exigence d'adresse email verifiee pour participer aux Bug Bounty.
# EVDP_VERIFICATION_ENFORCED_FROM est la date de bascule (AAAA-MM-JJ) : les
# comptes crees AVANT conservent l'acces pendant EVDP_VERIFICATION_GRACE_DAYS
# jours et sont relances a EVDP_VERIFICATION_REMINDER_DAYS jours de l'echeance.
# Les comptes crees apres n'ont aucun sursis. Vide = application immediate,
# sans sursis pour personne.
EVDP_VERIFICATION_ENFORCED_FROM=
EVDP_VERIFICATION_GRACE_DAYS=30
EVDP_VERIFICATION_REMINDER_DAYS=14,7,1


# --- PGP ---------------------------------------------------------------------
# Cle PUBLIQUE nationale uniquement. eVDP ne stocke aucune cle privee.
# Sur une seule ligne, sauts de ligne echappes en \n.
PGP_PUBLIC_KEY=
PGP_FINGERPRINT=

# --- Pieces jointes ----------------------------------------------------------
EVDP_MAX_ATTACHMENT_SIZE=26214400
# Plafond dedie aux videos (mp4/webm) : une demonstration filmee depasse vite
# 25 Mo. Nginx accepte jusqu'a 210 Mo sur les chemins de depot.
EVDP_MAX_VIDEO_ATTACHMENT_SIZE=209715200
EVDP_MAX_ATTACHMENTS_PER_CASE=20
# Antivirus : service evdp-clamav de docker-compose, actif par defaut.
# Laisser vide desactive l'analyse (deconseille).
CLAMAV_HOST=evdp-clamav
CLAMAV_PORT=3310
# Egal a StreamMaxLength de clamd : au-dela, le fichier est marque non analyse.
CLAMAV_STREAM_MAX_LENGTH=26214400

# --- Anti-abus ---------------------------------------------------------------
EVDP_CAPTCHA_ENABLED=False
EVDP_RL_LOGIN=10/5m
# Par compte vise, toutes IP confondues (essais repartis sur un botnet).
EVDP_RL_LOGIN_ACCOUNT=10/15m
EVDP_RL_REGISTER=5/1h
EVDP_RL_REPORT=10/1h
EVDP_RL_PASSWORD_RESET=5/1h
THROTTLE_REPORT_SUBMISSION=10/hour
THROTTLE_ANON_READ=60/hour
THROTTLE_AUTHENTICATED=1000/day

# --- Reputation (bareme configurable) ----------------------------------------
EVDP_REP_VALIDATED=10
EVDP_REP_HIGH=25
EVDP_REP_CRITICAL=50
EVDP_REP_DUPLICATE=0
EVDP_REP_ABUSIVE=-20

# --- Integrite des messages --------------------------------------------------
# Cle HMAC-SHA256 de signature des messages. 64 caracteres aleatoires.
# Generez avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
# Conservez-la HORS de la base. Sans elle, integrity_ok() est degrade.
MESSAGE_INTEGRITY_KEY=CHANGEZ-MOI-cle-hmac-64-caracteres

# --- Observabilite -----------------------------------------------------------
# Jeton Bearer exige par la vue /metrics/ (defense en profondeur).
# Generez avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
# Renseignez la meme valeur dans le job Prometheus.
METRICS_TOKEN=CHANGEZ-MOI-jeton-prometheus
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Infrastructure ----------------------------------------------------------
# Image de l'application. Vide : construite depuis le code (docker compose
# build). Version publiee par la CI, sans construction :
#   EVDP_IMAGE=ghcr.io/faso-shield/evdp-app:1.0.0
# puis docker compose pull evdp-web evdp-worker evdp-beat
# et docker compose up -d --no-build (docs/deployment.md, §3).
# EVDP_IMAGE=
HTTP_PORT=80
# Interface Mailpit, publiee sur 127.0.0.1 uniquement (http://127.0.0.1:8025).
MAILPIT_PORT=8025
GUNICORN_WORKERS=3
GUNICORN_THREADS=2

# ---- Cartographie ------------------------------------------------------------
# Par defaut : imagerie satellite Esri servie par le proxy Nginx /tiles/
# (docker/nginx/conf.d/tiles.inc, actif en dev ET en prod). Meme origine que
# la plateforme : rien a ajouter a la CSP. Ordre {z}/{y}/{x} impose par Esri.
# Alternative : une URL absolue est chargee directement par le navigateur et
# son origine est ajoutee a la CSP, par exemple
#   EVDP_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
#   EVDP_MAP_ATTRIBUTION=&copy; contributeurs OpenStreetMap
# Vide : carte sans fond.
EVDP_MAP_TILE_URL=/tiles/{z}/{y}/{x}
EVDP_MAP_ATTRIBUTION=Imagery &copy; Esri, Maxar, Earthstar Geographics
# Selecteur de fond de la carte nationale : Plan, Satellite, Hybride.
# Plan : World Street Map d'Esri, via le meme proxy (/tiles/plan/).
# Hybride : le satellite ci-dessus + les noms de lieux (/tiles/noms/).
# Une URL vide retire le choix du selecteur (un seul fond : pas de selecteur).
EVDP_MAP_STREET_URL=/tiles/plan/{z}/{y}/{x}
EVDP_MAP_STREET_ATTRIBUTION=&copy; Esri, HERE, Garmin, contributeurs OpenStreetMap
EVDP_MAP_LABELS_URL=/tiles/noms/{z}/{y}/{x}
# Fond a la premiere visite : plan, satellite ou hybride.
EVDP_MAP_DEFAULT_BASEMAP=plan
