# =============================================================================
# eVDP - bloc TLS pour la production
#
# Activez ce fichier en le renommant tls.conf, une fois les trois fichiers
# de certificat deposes dans docker/nginx/certs/ :
#   - evdp.crt   (fullchain.pem)
#   - evdp.key   (privkey.pem)
#   - chain.pem  (chain.pem — requis par ssl_trusted_certificate pour OCSP)
#
# Ajoutez egalement le port 443 dans docker-compose.yml :
#   ports:
#     - "0.0.0.0:${HTTP_PORT:-80}:80"
#     - "0.0.0.0:${HTTPS_PORT:-443}:443"
#
# Et montez le repertoire des certificats :
#   volumes:
#     - ./docker/nginx/certs:/etc/nginx/certs:ro
# =============================================================================

# Redirection HTTP -> HTTPS
# A l'activation du TLS, renommez evdp.conf en evdp.conf.http-only
# pour eviter deux blocs port 80 avec le meme server_name.
server {
    listen 80;
    listen [::]:80;
    server_name _;

    set $evdp_app "evdp-web:8000";

    # Challenge ACME pour le renouvellement Let's Encrypt (certbot --webroot).
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Sondes de vivacite accessibles en HTTP (load balancer en amont).
    location = /health/ {
        access_log off;
        proxy_pass http://$evdp_app$request_uri;
        include /etc/nginx/conf.d/proxy_headers.inc;
    }

    location = /ready/ {
        access_log off;
        proxy_pass http://$evdp_app$request_uri;
        include /etc/nginx/conf.d/proxy_headers.inc;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name _;

    # --- Certificats TLS -----------------------------------------------------
    ssl_certificate     /etc/nginx/certs/evdp.crt;
    ssl_certificate_key /etc/nginx/certs/evdp.key;

    # --- Protocoles et chiffrement -------------------------------------------
    # TLS 1.3 privilegie (cahier des charges FASO SHIELD v2.0).
    # TLS 1.2 AEAD conserve pour la compatibilite avec certains clients.
    # Pour TLS 1.3 seul : ssl_protocols TLSv1.3;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;

    # --- Session TLS ---------------------------------------------------------
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_early_data off;

    # --- OCSP Stapling -------------------------------------------------------
    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_trusted_certificate /etc/nginx/certs/chain.pem;

    # --- Diffie-Hellman (optionnel, renforce TLS 1.2) ------------------------
    # Generez avec : openssl dhparam -out /etc/nginx/certs/dhparam.pem 2048
    # ssl_dhparam /etc/nginx/certs/dhparam.pem;

    # --- En-tetes de securite ------------------------------------------------
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header X-Permitted-Cross-Domain-Policies "none" always;
    add_header X-Download-Options "noopen" always;

    set $evdp_app "evdp-web:8000";
    limit_conn evdp_conn 24;

    # --- Restriction des methodes HTTP (OWASP ASVS V14.5.1)
    if ($request_method !~ ^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)$) {
        return 405;
    }

    # --- Identifiant de requete (tracabilite forensique)
    add_header X-Request-ID $evdp_request_id always;

    # --- Sondes d'observabilite ----------------------------------------------
    location = /health/ {
        access_log off;
        proxy_pass http://$evdp_app$request_uri;
        include /etc/nginx/conf.d/proxy_headers.inc;
    }

    location = /ready/ {
        access_log off;
        proxy_pass http://$evdp_app$request_uri;
        include /etc/nginx/conf.d/proxy_headers.inc;
    }

    location = /metrics/ {
        allow 127.0.0.1;
        # allow 10.20.0.15;  # IP du collecteur Prometheus (a adapter)
        deny all;
        proxy_pass http://$evdp_app$request_uri;
        include /etc/nginx/conf.d/proxy_headers.inc;
    }

    # --- Fichiers statiques --------------------------------------------------
    location /static/ {
        alias /app/staticfiles/;
        access_log off;
        include /etc/nginx/conf.d/security_headers.inc;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Cache-Control "public, max-age=2592000, immutable" always;
    }

    # --- Fond de carte (proxy de tuiles, voir tiles.inc) ----------------------
    include /etc/nginx/conf.d/tiles.inc;

    location /media/ {
        deny all;
        return 404;
    }

    # --- Points sensibles : limitation renforcee -----------------------------
    location /login/ {
        limit_req zone=evdp_auth burst=5 nodelay;
        proxy_pass http://$evdp_app$request_uri;
        include /etc/nginx/conf.d/proxy_headers.inc;
    }

    location /register/ {
        limit_req zone=evdp_auth burst=3 nodelay;
        proxy_pass http://$evdp_app$request_uri;
        include /etc/nginx/conf.d/proxy_headers.inc;
    }

    location /password-reset/ {
        limit_req zone=evdp_auth burst=3 nodelay;
        proxy_pass http://$evdp_app$request_uri;
        include /etc/nginx/conf.d/proxy_headers.inc;
    }

    location /report/ {
        limit_req zone=evdp_report burst=5 nodelay;
        client_max_body_size 210m;
        client_body_timeout 120s;
        proxy_pass http://$evdp_app$request_uri;
        include /etc/nginx/conf.d/proxy_headers.inc;
    }

    location ~ ^/(cases/[^/]+/attachments|api/v1/reports)/ {
        limit_req zone=evdp_general burst=40 nodelay;
        client_max_body_size 210m;
        client_body_timeout 120s;
        proxy_pass http://$evdp_app$request_uri;
        include /etc/nginx/conf.d/proxy_headers.inc;
    }

    # --- Application ---------------------------------------------------------
    location / {
        limit_req zone=evdp_general burst=40 nodelay;
        proxy_pass http://$evdp_app$request_uri;
        include /etc/nginx/conf.d/proxy_headers.inc;
    }

    error_page 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
        internal;
    }
}
